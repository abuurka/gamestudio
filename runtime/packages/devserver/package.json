{
  "name": "@gamestudio/devserver",
  "version": "0.1.0",
  "description": "GameStudio Vite plugin: live-link hub, component registry generation and scene export serving.",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "default": "./src/index.js"
    },
    "./client": {
      "types": "./client.d.ts"
    },
    "./package.json": "./package.json"
  },
  "types": "./types/index.d.ts",
  "bin": {
    "gamestudio-registry": "./bin/gamestudio-registry.js",
    "gamestudio-compress": "./bin/gamestudio-compress.js",
    "gamestudio-stream": "./bin/gamestudio-stream.js",
    "gamestudio-browser": "./bin/gamestudio-browser.js"
  },
  "files": [
    "src",
    "bin",
    "types",
    "client.d.ts",
    "LICENSE"
  ],
  "scripts": {
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@puppeteer/browsers": "3.2.4",
    "meshoptimizer": "1.1.1",
    "puppeteer-core": "25.13.0",
    "ws": "8.22.0",
    "yauzl": "3.4.0"
  },
  "peerDependencies": {
    "vite": "^8.0.0"
  },
  "devDependencies": {
    "@types/ws": "8.18.2"
  }
}
